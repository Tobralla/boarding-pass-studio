PORT=5173
# Optional: copy to .env and fill these values to use your own signing certificate.
# Without these settings, .pkpass downloads use the free WalletMCPPass service.
PASS_TYPE_IDENTIFIER=
TEAM_IDENTIFIER=
PASS_CERT_PATH=
PASS_KEY_PATH=
WWDR_CERT_PATH=
# Optional password for an encrypted RSA PEM private key.
PASS_KEY_PASSPHRASE=

# Hosted backend: comma-separated permitted frontend origins (no path or trailing slash).
ALLOWED_ORIGINS=https://tobralla.github.io
# For a GitHub Pages frontend, set this as a repository Actions variable.
# VITE_API_BASE=https://your-signing-server.example.com
# Production defaults to 0.0.0.0; development defaults to 127.0.0.1.
# HOST=0.0.0.0
